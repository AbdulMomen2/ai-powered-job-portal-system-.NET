@model MercorClone.Web.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
    Layout = null;
    var roleHint = Context.Request.Query["role"].ToString();
    var isEmployer = roleHint == "Employer";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Account — JobConnect</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: { primary: '#7c3aed', primaryHover: '#6d28d9' },
                    fontFamily: { sans: ['Inter','ui-sans-serif','system-ui','sans-serif'] }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="bg-gray-50 font-sans text-gray-900 antialiased min-h-screen flex flex-col">

    <!-- Minimal navbar -->
    <nav class="bg-white border-b border-gray-200">
        <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <a href="/" class="flex items-center gap-2">
                <div class="w-8 h-8 bg-primary rounded-lg flex items-center justify-center shadow-sm">
                    <svg class="text-white w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                </div>
                <span class="text-xl font-bold tracking-tight text-gray-900">JobConnect</span>
            </a>
            <span class="text-sm text-gray-500">Already have an account? <a href="/Account/Login" class="text-primary font-semibold hover:underline">Log in</a></span>
        </div>
    </nav>

    <main class="flex-1 flex items-center justify-center px-4 py-12">
        <div class="w-full max-w-lg">

            <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8">
                <div class="text-center mb-8">
                    <div class="w-12 h-12 bg-purple-50 rounded-2xl flex items-center justify-center mx-auto mb-4">
                        <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
                    </div>
                    <h1 class="text-2xl font-bold text-gray-900">Join JobConnect</h1>
                    <p class="text-sm text-gray-500 mt-1">Find top talent or your next career move</p>
                </div>

                <form asp-action="Register" method="post" class="space-y-5">
                    <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 border border-red-200 rounded-xl px-4 py-3"></div>

                    <!-- Account type toggle -->
                    <div>
                        <p class="text-sm font-medium text-gray-700 mb-2">I want to...</p>
                        <div class="grid grid-cols-2 gap-3" id="roleToggle">
                            <label class="role-card cursor-pointer rounded-xl border-2 p-4 transition-all @(isEmployer ? "border-gray-200" : "border-primary bg-purple-50")" id="cardCandidate">
                                <input type="radio" asp-for="UserType" value="Candidate" class="sr-only" checked="@(!isEmployer)" />
                                <div class="flex flex-col items-center gap-2 text-center">
                                    <div class="w-9 h-9 rounded-xl bg-white border border-gray-200 flex items-center justify-center shadow-sm">
                                        <svg class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                                    </div>
                                    <div>
                                        <p class="text-sm font-semibold text-gray-900">Find a Job</p>
                                        <p class="text-xs text-gray-500 mt-0.5">I'm a candidate</p>
                                    </div>
                                </div>
                            </label>

                            <label class="role-card cursor-pointer rounded-xl border-2 p-4 transition-all @(isEmployer ? "border-primary bg-purple-50" : "border-gray-200")" id="cardEmployer">
                                <input type="radio" asp-for="UserType" value="Employer" class="sr-only" checked="@isEmployer" />
                                <div class="flex flex-col items-center gap-2 text-center">
                                    <div class="w-9 h-9 rounded-xl bg-white border border-gray-200 flex items-center justify-center shadow-sm">
                                        <svg class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                                    </div>
                                    <div>
                                        <p class="text-sm font-semibold text-gray-900">Hire Talent</p>
                                        <p class="text-xs text-gray-500 mt-0.5">I'm an employer</p>
                                    </div>
                                </div>
                            </label>
                        </div>
                        <span asp-validation-for="UserType" class="text-xs text-red-500 mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="FullName" class="block text-sm font-medium text-gray-700 mb-1.5">Full name</label>
                        <input asp-for="FullName" type="text" placeholder="John Doe"
                               class="w-full px-4 py-2.5 rounded-xl border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition placeholder-gray-400" />
                        <span asp-validation-for="FullName" class="text-xs text-red-500 mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-1.5">Work email</label>
                        <input asp-for="Email" type="email" placeholder="name@company.com"
                               class="w-full px-4 py-2.5 rounded-xl border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition placeholder-gray-400" />
                        <span asp-validation-for="Email" class="text-xs text-red-500 mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="Password" class="block text-sm font-medium text-gray-700 mb-1.5">Password</label>
                        <div class="relative">
                            <input asp-for="Password" type="password" id="passwordInput" placeholder="Min. 8 characters"
                                   class="w-full px-4 py-2.5 rounded-xl border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition placeholder-gray-400 pr-10"
                                   oninput="checkStrength(this.value)" />
                            <button type="button" onclick="togglePassword()" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                            </button>
                        </div>
                        <!-- Password strength meter -->
                        <div class="flex gap-1 mt-2">
                            <div id="s1" class="h-1 flex-1 rounded-full bg-gray-200 transition-colors duration-300"></div>
                            <div id="s2" class="h-1 flex-1 rounded-full bg-gray-200 transition-colors duration-300"></div>
                            <div id="s3" class="h-1 flex-1 rounded-full bg-gray-200 transition-colors duration-300"></div>
                            <div id="s4" class="h-1 flex-1 rounded-full bg-gray-200 transition-colors duration-300"></div>
                        </div>
                        <p id="strengthLabel" class="text-xs text-gray-400 mt-1"></p>
                        <span asp-validation-for="Password" class="text-xs text-red-500 mt-1 block"></span>
                    </div>

                    <button type="submit"
                            class="w-full bg-primary text-white py-2.5 rounded-xl text-sm font-semibold hover:bg-primaryHover transition-colors shadow-sm">
                        Create Account
                    </button>

                    <p class="text-xs text-gray-400 text-center">
                        By creating an account you agree to our <a href="/Privacy" class="hover:underline text-gray-500">Privacy Policy</a> and <a href="/Terms" class="hover:underline text-gray-500">Terms of Service</a>.
                    </p>
                </form>

                <p class="text-center text-sm text-gray-500 mt-6">
                    Already have an account? <a href="/Account/Login" class="text-primary font-semibold hover:underline">Log in</a>
                </p>
            </div>
        </div>
    </main>

    <script>
        // Role card toggle
        document.querySelectorAll('.role-card').forEach(card => {
            card.addEventListener('click', () => {
                const radio = card.querySelector('input[type=radio]');
                radio.checked = true;
                document.querySelectorAll('.role-card').forEach(c => {
                    c.classList.remove('border-primary','bg-purple-50');
                    c.classList.add('border-gray-200');
                });
                card.classList.add('border-primary','bg-purple-50');
                card.classList.remove('border-gray-200');
            });
        });

        function togglePassword() {
            const input = document.getElementById('passwordInput');
            input.type = input.type === 'password' ? 'text' : 'password';
        }

        function checkStrength(val) {
            const bars = [document.getElementById('s1'),document.getElementById('s2'),document.getElementById('s3'),document.getElementById('s4')];
            const label = document.getElementById('strengthLabel');
            let score = 0;
            if (val.length >= 8) score++;
            if (/[A-Z]/.test(val)) score++;
            if (/[0-9]/.test(val)) score++;
            if (/[^A-Za-z0-9]/.test(val)) score++;

            const colors = ['bg-red-400','bg-orange-400','bg-yellow-400','bg-green-500'];
            const labels = ['Weak','Fair','Good','Strong'];
            bars.forEach((b, i) => {
                b.className = `h-1 flex-1 rounded-full transition-colors duration-300 ${i < score ? colors[score - 1] : 'bg-gray-200'}`;
            });
            label.textContent = val.length > 0 ? labels[score - 1] || '' : '';
        }
    </script>
    @section Scripts {
        @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    }
</body>
</html>