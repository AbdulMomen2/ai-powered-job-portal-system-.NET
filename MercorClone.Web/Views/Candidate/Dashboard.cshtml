@using MercorClone.Web.Models.ViewModels.Candidate
@model CandidateDashboardViewModel
@{
    ViewData["Title"] = "My Dashboard";
    Layout = null;
    var avatarLetter = Model.FullName.Length > 0 ? Model.FullName[0].ToString().ToUpper() : "U";
    var firstName = Model.FullName.Split(' ')[0];
    var profilePct = Model.Profile == null ? 0
        : (new[] {
            !string.IsNullOrEmpty(Model.Profile.PhoneNumber),
            !string.IsNullOrEmpty(Model.Profile.ProfileSummary),
            !string.IsNullOrEmpty(Model.Profile.Country),
            Model.Profile.Mastery?.SkillTags.Length > 0,
            Model.Profile.Experiences.Any()
          }).Count(x => x) * 20;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — JobConnect</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: { primary: '#7c3aed', primaryHover: '#6d28d9' },
                    fontFamily: { sans: ['Inter','ui-sans-serif','system-ui','sans-serif'] }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        #profileDropdown { transform-origin: top right; }
        #profileDropdown.open { display: block; animation: fd 0.15s ease; }
        @@keyframes fd { from { opacity:0; transform:scale(.95); } to { opacity:1; transform:scale(1); } }
    </style>
</head>
<body class="bg-gray-50 font-sans text-gray-900 antialiased min-h-screen flex flex-col">

    @* ── Flash messages ── *@
    @if (ViewBag.SuccessMessage != null)
    {
        <div class="bg-green-50 border-b border-green-200 px-4 py-2.5 text-sm text-green-700 font-medium text-center">@ViewBag.SuccessMessage</div>
    }
    @if (ViewBag.WarningMessage != null)
    {
        <div class="bg-amber-50 border-b border-amber-200 px-4 py-2.5 text-sm text-amber-700 font-medium text-center">@ViewBag.WarningMessage</div>
    }

    @* ── NAVBAR ── *@
    <nav class="bg-white border-b border-gray-200 sticky top-0 z-40">
        <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center gap-8">
                    <a href="/" class="flex items-center gap-2">
                        <div class="w-8 h-8 bg-primary rounded-lg flex items-center justify-center shadow-sm">
                            <svg class="text-white w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                        </div>
                        <span class="text-xl font-bold tracking-tight text-gray-900">JobConnect</span>
                    </a>
                    <div class="hidden md:flex items-center gap-6 text-sm font-medium text-gray-500">
                        <a href="/" class="hover:text-primary transition-colors">Find Jobs</a>
                        <a href="/Candidate/JobActivity" class="hover:text-primary transition-colors">My Applications</a>
                        <a href="#company-reviews" class="hover:text-primary transition-colors">Company Reviews</a>
                    </div>
                </div>

                <div class="relative" id="profileMenuWrapper">
                    <button onclick="toggleProfileMenu()" class="flex items-center gap-2 pl-2 pr-3 py-1.5 rounded-full border border-gray-200 hover:border-primary hover:shadow-sm transition-all bg-white">
                        <div class="w-7 h-7 rounded-full bg-primary flex items-center justify-center text-white text-xs font-bold">@avatarLetter</div>
                        <span class="text-sm font-medium text-gray-700 hidden sm:block">@firstName</span>
                        <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                    </button>

                    <div id="profileDropdown" class="hidden absolute right-0 mt-2 w-56 bg-white rounded-2xl shadow-xl border border-gray-200 overflow-hidden z-50 py-1">
                        <div class="px-4 py-3 border-b border-gray-100">
                            <p class="text-sm font-bold text-gray-900 truncate">@Model.FullName</p>
                            <p class="text-xs text-gray-500 truncate">@Model.Email</p>
                        </div>
                        <a href="/Candidate/Dashboard" class="flex items-center gap-3 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 transition-colors font-medium bg-gray-50">Dashboard</a>
                        <a href="/Candidate/AccountSettings#cv" class="flex items-center gap-3 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 transition-colors">CV and experience</a>
                        <a href="/Candidate/AccountSettings#preferences" class="flex items-center gap-3 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 transition-colors">Job preferences</a>
                        <a href="/Candidate/JobActivity" class="flex items-center gap-3 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 transition-colors">Job activity</a>
                        <div class="border-t border-gray-100 my-1"></div>
                        <a href="/Candidate/AccountSettings" class="flex items-center gap-3 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 transition-colors">Account settings</a>
                        <a href="/Account/VerifyPhone" class="flex items-center gap-3 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 transition-colors">Verify phone</a>
                        <a href="/Help" class="flex items-center gap-3 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 transition-colors">Help centre</a>
                        <div class="border-t border-gray-100 mt-1">
                            <form action="/Account/Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm text-red-600 hover:bg-red-50 transition-colors font-medium">Sign out</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <main class="flex-1 max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">

        @* ── HEADER ── *@
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
            <div>
                <p class="text-sm text-gray-500 font-medium mb-1">Candidate Dashboard</p>
                <h1 class="text-2xl font-bold text-gray-900">Welcome back, @firstName 👋</h1>
            </div>
            <a href="/" class="inline-flex items-center gap-2 bg-primary text-white text-sm font-semibold px-5 py-2.5 rounded-full hover:bg-primaryHover transition-colors shadow-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                Browse Jobs
            </a>
        </div>

        @* ── PROFILE COMPLETION BANNER ── *@
        @if (profilePct < 100)
        {
            <div class="bg-gradient-to-r from-violet-50 to-purple-50 border border-violet-200 rounded-2xl p-5 mb-8 flex flex-col sm:flex-row items-start sm:items-center gap-4">
                <div class="flex-1">
                    <div class="flex items-center justify-between mb-2">
                        <p class="text-sm font-bold text-violet-800">Complete your profile to get better matches</p>
                        <span class="text-sm font-bold text-primary">@profilePct%</span>
                    </div>
                    <div class="w-full bg-violet-200 rounded-full h-2">
                        <div class="bg-primary h-2 rounded-full transition-all duration-500" style="width: @profilePct%"></div>
                    </div>
                    <p class="text-xs text-violet-600 mt-2">Add your skills, experience, and summary to stand out to employers.</p>
                </div>
                <a href="/Candidate/AccountSettings" class="flex-shrink-0 text-sm font-semibold text-white bg-primary px-4 py-2 rounded-xl hover:bg-primaryHover transition-colors shadow-sm">Complete Profile</a>
            </div>
        }

        @* ── STATS ── *@
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-10">
            <div class="bg-white border border-gray-200 rounded-2xl p-5 hover:shadow-sm transition-shadow">
                <p class="text-xs text-gray-500 font-medium mb-2">Applications</p>
                <p class="text-3xl font-bold text-gray-900">@Model.Applications.Count()</p>
                <p class="text-xs text-gray-400 mt-1">Total submitted</p>
            </div>
            <div class="bg-white border border-gray-200 rounded-2xl p-5 hover:shadow-sm transition-shadow">
                <p class="text-xs text-gray-500 font-medium mb-2">In Review</p>
                <p class="text-3xl font-bold text-gray-900">@Model.Applications.Count(a => a.Status == "Applied" || a.Status == "Reviewing")</p>
                <p class="text-xs text-gray-400 mt-1">Awaiting response</p>
            </div>
            <div class="bg-white border border-gray-200 rounded-2xl p-5 hover:shadow-sm transition-shadow">
                <p class="text-xs text-gray-500 font-medium mb-2">Interviews</p>
                <p class="text-3xl font-bold text-gray-900">@Model.Applications.Count(a => a.Status == "Interview" || a.Status == "AIInterview")</p>
                <p class="text-xs text-gray-400 mt-1">Scheduled</p>
            </div>
            <div class="bg-white border border-gray-200 rounded-2xl p-5 hover:shadow-sm transition-shadow">
                <p class="text-xs text-gray-500 font-medium mb-2">Profile</p>
                <p class="text-3xl font-bold @(profilePct == 100 ? "text-green-500" : "text-primary")">@profilePct%</p>
                <p class="text-xs text-gray-400 mt-1">Completion</p>
            </div>
        </div>

        <div class="grid lg:grid-cols-3 gap-6">

            @* ── RECENT APPLICATIONS ── *@
            <div class="lg:col-span-2">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-lg font-bold text-gray-900">Recent Applications</h2>
                    <a href="/Candidate/JobActivity" class="text-sm font-semibold text-primary hover:underline">View all →</a>
                </div>

                @if (!Model.Applications.Any())
                {
                    <div class="bg-white border border-dashed border-gray-300 rounded-2xl p-10 text-center">
                        <svg class="w-10 h-10 mx-auto mb-3 text-gray-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                        <p class="text-sm text-gray-500 mb-4">You haven't applied to any jobs yet.</p>
                        <a href="/" class="inline-flex items-center gap-1.5 bg-primary text-white text-sm font-semibold px-5 py-2.5 rounded-xl hover:bg-primaryHover transition-colors shadow-sm">Browse Jobs</a>
                    </div>
                }
                else
                {
                    <div class="space-y-3">
                        @foreach (var app in Model.Applications.Take(5))
                        {
                            var statusColor = app.Status switch {
                                "Applied"    => "bg-blue-50 text-blue-700",
                                "Reviewing"  => "bg-yellow-50 text-yellow-700",
                                "Interview"  => "bg-green-50 text-green-700",
                                "AIInterview"=> "bg-purple-50 text-purple-700",
                                "Offered"    => "bg-emerald-50 text-emerald-700",
                                "Rejected"   => "bg-red-50 text-red-600",
                                _            => "bg-gray-100 text-gray-600"
                            };
                            <div class="bg-white border border-gray-200 rounded-xl p-4 flex items-center gap-4 hover:shadow-sm hover:border-gray-300 transition-all">
                                <!-- Company logo placeholder -->
                                <div class="w-10 h-10 rounded-xl bg-gray-100 border border-gray-200 flex items-center justify-center text-xs font-bold text-gray-500 flex-shrink-0">
                                    @(app.JobPost.Company?.Name.Substring(0,1).ToUpper() ?? "?")
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-bold text-gray-900 truncate">@app.JobPost.Title</p>
                                    <p class="text-xs text-gray-500 truncate">@app.JobPost.Company?.Name • @app.JobPost.LocationType</p>
                                </div>
                                <div class="flex-shrink-0 flex flex-col items-end gap-1.5">
                                    <span class="text-[11px] font-semibold px-2 py-0.5 rounded-full @statusColor">@app.Status</span>
                                    <p class="text-[11px] text-gray-400">@app.CreatedAt.ToString("MMM dd")</p>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            @* ── SIDEBAR ── *@
            <div class="space-y-5">

                @* Profile card *@
                <div class="bg-white border border-gray-200 rounded-2xl p-5">
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-12 h-12 rounded-full bg-primary flex items-center justify-center text-white font-bold text-lg">@avatarLetter</div>
                        <div class="min-w-0">
                            <p class="text-sm font-bold text-gray-900 truncate">@Model.FullName</p>
                            <p class="text-xs text-gray-500 truncate">@Model.Email</p>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Profile?.ProfileSummary))
                    {
                        <p class="text-xs text-gray-500 line-clamp-3 mb-3">@Model.Profile.ProfileSummary</p>
                    }
                    @if (Model.Profile?.Mastery?.SkillTags.Length > 0)
                    {
                        <div class="flex flex-wrap gap-1.5 mb-4">
                            @foreach (var skill in Model.Profile.Mastery.SkillTags.Take(5))
                            {
                                <span class="text-xs text-primary bg-purple-50 border border-purple-100 px-2 py-0.5 rounded-full font-medium">@skill</span>
                            }
                            @if (Model.Profile.Mastery.SkillTags.Length > 5)
                            {
                                <span class="text-xs text-gray-400 font-medium">+@(Model.Profile.Mastery.SkillTags.Length - 5)</span>
                            }
                        </div>
                    }
                    <a href="/Candidate/AccountSettings" class="w-full block text-center text-sm font-semibold border border-gray-200 text-gray-700 py-2 rounded-xl hover:bg-gray-50 transition-colors">Edit Profile</a>
                </div>

                @* Quick actions *@
                <div class="bg-white border border-gray-200 rounded-2xl p-5">
                    <h3 class="text-sm font-bold text-gray-900 mb-3">Quick Actions</h3>
                    <div class="space-y-2">
                        <a href="/" class="flex items-center gap-2.5 text-sm text-gray-700 hover:text-primary transition-colors py-1.5">
                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                            Browse all jobs
                        </a>
                        <a href="/Candidate/AccountSettings#cv" class="flex items-center gap-2.5 text-sm text-gray-700 hover:text-primary transition-colors py-1.5">
                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                            Upload / update CV
                        </a>
                        <a href="/Account/VerifyPhone" class="flex items-center gap-2.5 text-sm text-gray-700 hover:text-primary transition-colors py-1.5">
                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                            Verify phone / WhatsApp
                        </a>
                        <a href="/Candidate/JobActivity" class="flex items-center gap-2.5 text-sm text-gray-700 hover:text-primary transition-colors py-1.5">
                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2"/></svg>
                            View all applications
                        </a>
                    </div>
                </div>
            </div>
        </div>

        @* ── RECOMMENDED JOBS ── *@
        @if (Model.RecommendedJobs.Any())
        {
            <div class="mt-10">
                <div class="flex items-center justify-between mb-5">
                    <h2 class="text-lg font-bold text-gray-900">Recommended for You</h2>
                    <a href="/" class="text-sm font-semibold text-primary hover:underline">See all →</a>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
                    @foreach (var job in Model.RecommendedJobs)
                    {
                        <div class="bg-white border border-gray-200 rounded-xl p-5 hover:shadow-md hover:border-gray-300 transition-all flex flex-col justify-between min-h-[150px] group">
                            <div>
                                <div class="flex justify-between items-start gap-2">
                                    <h3 class="font-semibold text-gray-900 text-sm line-clamp-2 group-hover:text-primary transition-colors">@job.Title</h3>
                                    <span class="text-xs text-primary bg-purple-50 px-2 py-0.5 rounded font-medium whitespace-nowrap flex-shrink-0">Apply ↗</span>
                                </div>
                                @if (job.Company != null)
                                {
                                    <p class="text-xs text-gray-400 mt-0.5 font-medium">@job.Company.Name</p>
                                }
                                <p class="text-gray-500 text-xs mt-1">
                                    @(job.MinSalary.HasValue ? $"${job.MinSalary}–${job.MaxSalary}/hr" : "Competitive salary")
                                </p>
                            </div>
                            <div class="mt-4">
                                <form action="/Candidate/Apply" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="jobPostId" value="@job.Id" />
                                    <button type="submit" class="w-full text-center text-xs font-semibold text-primary border border-primary/30 bg-purple-50 hover:bg-primary hover:text-white py-2 rounded-lg transition-all">
                                        Quick Apply
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

    </main>

    <footer class="border-t border-gray-100 py-6 mt-auto">
        <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between text-xs text-gray-400">
            <span>© @DateTime.Now.Year JobConnect. All rights reserved.</span>
            <div class="flex gap-4">
                <a href="/Privacy" class="hover:text-gray-600 transition-colors">Privacy</a>
                <a href="/Terms" class="hover:text-gray-600 transition-colors">Terms</a>
            </div>
        </div>
    </footer>

    <script>
        const dropdown = document.getElementById('profileDropdown');
        function toggleProfileMenu() {
            dropdown?.classList.toggle('hidden');
            dropdown?.classList.toggle('open');
        }
        document.addEventListener('click', (e) => {
            const wrapper = document.getElementById('profileMenuWrapper');
            if (wrapper && !wrapper.contains(e.target)) {
                dropdown?.classList.add('hidden');
                dropdown?.classList.remove('open');
            }
        });
    </script>
</body>
</html>