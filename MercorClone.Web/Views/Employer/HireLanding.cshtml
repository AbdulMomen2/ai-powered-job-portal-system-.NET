@{ Layout = "_Layout"; }
<div class="container py-5 mt-5">
    <div class="row align-items-center">
        <div class="col-lg-7">
            <h1 class="display-3 fw-bold">Post your job on the #1 hiring platform.</h1>
            <p class="lead mb-4">MercorClone helps you find the right fit, faster. Post your job and let our AI handle the matching.</p>
            <a asp-controller="JobPost" asp-action="Create" class="btn btn-primary btn-lg px-5 py-3 shadow">Post a job</a>
        </div>
        <div class="col-lg-5">
            <img src="https://d3fw5vlhllyvee.cloudfront.net/hire/full-stack-illustration.png" class="img-fluid" />
        </div>
    </div>
</div>